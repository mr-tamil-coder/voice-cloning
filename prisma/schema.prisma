generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VoiceVariant {
  SYSTEM
  CUSTOM
}

enum VoiceCategory {
  AUDIOBOOK
  CONVERSATIONAL
  CUSTOMER_SERVICE
  GENERAL
  NARRATIVE
  CHARACTERS
  MEDITATION
  MOTIVATIONAL
  PODCAST
  ADVERTISING
  VOICEOVER
  CORPORATE
}

model Voice {
  id String @id @default(cuid())
  orgId String?
  name        String
  description String?
  category    VoiceCategory @default(GENERAL)
  language    String        @default("en-US")
  // variant -> custom or system voice...objectKey -> where we are going to store..
  variant     VoiceVariant
  r2ObjectKey String?
// voice  have many generations....make it array...
  generations Generation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variant])
  @@index([orgId])
}

model Generation {
  id String @id @default(cuid())
  orgId String // only organization create generation
  //generation have only one voice::)
  voiceId String? //optional : 
  voice   Voice?  @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  // We can use "onDelete : Cascade..".every single genrtion done with voice ..if voice is deleted from db..every single genration related also delted....that why we used "SetNull"

  text              String
  voiceName         String
  r2ObjectKey       String? //if exists : ready to listen..else not ready..
  temperature       Float
  topP              Float
  topK              Int
  repetitionPenalty Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([voiceId])
}